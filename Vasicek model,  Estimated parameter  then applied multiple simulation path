import numpy as np
import matplotlib.pyplot as plt

#####  Single path Simulation 

k = 0.5 # mean reversion speed
theta = 0.05    
sigma = 0.02     
r0 = 0.03        

# Simulation parameters
T = 10           # time horizon (in years)
N = 1000         # number of time steps
dt = T/N        #  10 years of period splitted into 1000 of parts, this is diff. and monte carlo simulation part different.   


### single path simulation 
np.random.seed(42)
r  = np.zeros(N)
r[0] = r0

for i in range(1, N):
  dw = np.random.normal(0, np.sqrt(dt)) 
  ### In Brownian motion, the standard deviation of the random change is proportional to the square root of the time interval.

  r[i] = r[i-1] + k*(theta - r[i - 1])* dt + sigma * dw


plt.plot(r)
plt.axhline(theta, color = "red",linestyle= '--', label = "Long-term mean (theta)")
plt.xlabel("Steps")
plt.ylabel("Interst Rate")
plt.title("Vasicek model simulation of interest rate")
plt.legend()
plt.show()


##### Multiple Path Simulation 

n_paths = 100
r = np.zeros((N, n_paths))
r[0, :] = r0

for i in range(N):
  dw = np.random.normal(0, np.sqrt(dt), n_paths)
  r[i, :] = r[i-1, :] + k*(theta - r[i - 1, :])* dt + sigma * dw


plt.figure(figsize=(12,6))
plt.plot(r)
plt.axhline(theta, color ="red", linestyle = "--", label ="theta", linewidth = "1.5")
plt.xlabel('Step')
plt.ylabel('Interest Rate')
plt.title(f'Vasicek Model Simulation of Interest Rates ({n_paths} Paths)')
plt.legend()
plt.show()




##### Zero Coupon Bond Yield Curve 

### Zero Coupon Bond Pricing 

def vasicek_bond_price(r, k, theta, sigma, tau):
  B = (1  - np.exp(-k * tau)) / k
  A = np.exp((theta - sigma**2 / (2 * k**2)) * (B - tau) - (sigma**2 / (4 * k)) * B**2)
  return A * np.exp(-B * r)


taus = np.linspace(0.25, 30, 200)
# range(start, stop, step): You specify the interval (step size).
# np.linspace(start, stop, num): You specify the total number of equally spaced points.

r_current = 0.08

prices = vasicek_bond_price(r_current, k, theta ,sigma, taus)
yields = -np.log(prices) / taus

plt.figure(figsize=(10, 5))
plt.plot(taus, yields * 100)
plt.xlabel('Maturity (years)')
plt.ylabel('Yield (%)')
plt.title(f'Vasicek Yield Curve (r={r_current*100:.1f}%, θ={theta*100:.1f}%)')
plt.grid(alpha=0.3)
plt.show()



